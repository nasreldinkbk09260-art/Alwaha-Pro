{
  "name": "alwaha-pro",
  "version": "3.0.3",
  "description": "Alwaha-Pro Unified Web and Mobile Application",
  "private": true,
  "main": "index.html",
  "scripts": {
    "start": "npx serve .",
    "build": "node scripts/build-web.mjs",
    "cap:sync": "npx cap sync",
    "audit:release": "node scripts/release-preflight.mjs",
    "prebuild": "node scripts/vendor-assets.mjs",
    "audit:performance": "node scripts/performance-audit.mjs",
    "audit:field-repair": "node scripts/field-repair-audit.mjs",
    "audit:chat": "node scripts/chat-release-audit.mjs",
    "audit:compatibility": "node scripts/compatibility-audit.mjs",
    "audit:native-call-ui": "node scripts/native-call-ui-audit.mjs && node scripts/call-feedback-runtime-test.mjs && node scripts/call-signaling-runtime-test.mjs",
    "audit:adaptive-video-quality": "node scripts/adaptive-video-quality-runtime-test.mjs",
    "audit:ui": "node scripts/ui-handler-audit.mjs",
    "audit:retention-kids-vault": "node scripts/retention-kids-vault-audit.mjs",
    "audit:admin": "node scripts/admin-app-audit.mjs",
    "audit:marketplace-columns": "node scripts/marketplace-column-audit.mjs",
    "audit:reconciliation": "node scripts/reconciliation-audit.mjs",
    "audit:fullscreen-ui": "node scripts/fullscreen-ui-audit.mjs",
    "audit:themes": "node scripts/theme-runtime-test.mjs",
    "audit:runtime": "node scripts/runtime-boot-audit.mjs",
    "audit:games": "node scripts/game-actions-audit.mjs && node scripts/qr-runtime-test.mjs",
    "audit:navigation-dock": "node scripts/navigation-dock-runtime-test.mjs",
    "audit:home": "node scripts/home-section-acceptance.mjs",
    "audit:smart-assistant": "node scripts/smart-assistant-runtime-test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "8.5.2",
    "@capacitor/ios": "8.5.2",
    "@fontsource/cairo": "5.3.0",
    "@fortawesome/fontawesome-free": "7.3.1",
    "@supabase/supabase-js": "2.116.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "esbuild": "^0.28.2"
  },
  "author": "Nasreldin",
  "license": "MIT"
}
