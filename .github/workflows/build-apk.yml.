name: بناء تطبيق واحة المحترفين الموحد (APK & AAB)

on:
  push:
    branches:
      - main
      - master
  workflow_dispatch:

permissions:
  contents: write

jobs:
  build-android:
    runs-on: ubuntu-latest

    steps:
      - name: جلب السورس كود
        uses: actions/checkout@v4

      - name: إعداد بيئة Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 20

      - name: إعداد بيئة Java JDK 17
        uses: actions/setup-java@v4
        with:
          distribution: 'zulu'
          java-version: '17'

      - name: إعداد Android SDK
        uses: android-actions/setup-android@v3

      - name: تثبيت التبعيات وإنشاء المجلد الموحد
        run: |
          npm install -g @capacitor/cli
          npm install
          mkdir -p www
          cp index.html www/ 2>/dev/null || true
          cp icon.png www/ 2>/dev/null || true

      - name: إعداد منصة أندرويد عبر Capacitor
        run: |
          npx cap add android || true
          npx cap sync android

      - name: بناء حزمة APK و AAB
        run: |
          cd android
          chmod +x gradlew
          ./gradlew assembleDebug --stacktrace
          ./gradlew bundleRelease --stacktrace

      - name: رفع ملفات APK و AAB كـ Artifacts
        uses: actions/upload-artifact@v4
        with:
          name: AlwahaPro-App-Packages
          path: |
            android/app/build/outputs/apk/debug/app-debug.apk
            android/app/build/outputs/bundle/release/app-release.aab

      - name: إنشاء Release وتوفير روابط التحميل المباشرة
        uses: softprops/action-gh-release@v2
        if: github.ref == 'refs/heads/main' || github.ref == 'refs/heads/master' || startsWith(github.ref, 'refs/tags/')
        with:
          tag_name: v2.7.0-build-${{ github.run_number }}
          name: واحة المحترفين الإصدار الموحد v2.7.0
          body: |
            تم بناء تطبيق **واحة المحترفين** بنجاح.
            
            **الملفات المتاحة للتحميل:**
            * `app-debug.apk`: جاهز للتثبيت المباشر على الهاتف.
            * `app-release.aab`: مخصص للرفع على Google Play Console.
          files: |
            android/app/build/outputs/apk/debug/app-debug.apk
            android/app/build/outputs/bundle/release/app-release.aab
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
