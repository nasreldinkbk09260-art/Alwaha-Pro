name: بناء تطبيق واحة المحترفين الموحد (APK & AAB)

on:
  push:
    branches:
      - main
      - master
  workflow_dispatch:

jobs:
  build-android:
    runs-on: ubuntu-latest

    steps:
      - name: جلب السورس كود
        uses: actions/checkout@v3

      - name: إعداد بيئة Node.js
        uses: actions/setup-node@v3
        with:
          node-version: 18

      - name: إعداد بيئة Java JDK 17
        uses: actions/setup-java@v3
        with:
          distribution: 'zulu'
          java-version: '17'

      - name: إعداد Android SDK
        uses: android-actions/setup-android@v2

      - name: تثبيت التبعيات وإنشاء المجلد الموحد
        run: |
          npm install -g @capacitor/cli
          npm install
          mkdir -p www
          cp index.html www/
          cp icon.png www/ || true

      - name: إعداد منصة أندرويد عبر Capacitor
        run: |
          npx cap add android
          npx cap sync android

      - name: بناء حزمة APK و AAB
        run: |
          cd android
          chmod +x gradlew
          ./gradlew assembleDebug
          ./gradlew bundleRelease

      - name: رفع ملفات APK و AAB المبنية للتحميل المباشر
        uses: actions/upload-artifact@v3
        with:
          name: AlwahaPro-App-Packages
          path: |
            android/app/build/outputs/apk/debug/app-debug.apk
            android/app/build/outputs/bundle/release/app-release.aab

      - name: إنشاء إعلان وتوليد رابط تنزيل مباشر (Release)
        uses: softprops/action-gh-release@v1
        if: startsWith(github.ref, 'refs/tags/') || github.ref == 'refs/heads/main'
        with:
          tag_name: v2.7.0-release-${{ github.run_number }}
          name: واحة المحترفين الإصدار الموحد v2.7.0
          body: |
            تم بناء تطبيق **واحة المحترفين** بنجاح وتكامله تلقائياً مع قاعدة بيانات Supabase.
            
            تحميل الملفات:
            * **حزمة APK المباشرة**: جاهزة للتثبيت المباشر على الهاتف.
            * **حزمة AAB**: مخصصة للرفع على متجر Google Play.
          files: |
            android/app/build/outputs/apk/debug/app-debug.apk
            android/app/build/outputs/bundle/release/app-release.aab
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
